# Copy to .env.local for local development, and set the same names in the
# deploy project. VITE_* values are inlined at build time.
#
# These are public by design. Watching a channel needs no secret,
# and the *write* token belongs to the sending project, never to this app.

# REST base of the realtime server — used by the viewer.
VITE_LIVELOG_URL=http://localhost:4504

# Viewer socket. Can be omitted when VITE_LIVELOG_URL is set — it is then
# derived as ws://…/ws or wss://…/ws from it. Must be wss:// in production: an
# HTTPS page cannot open a plain ws:// connection.
VITE_LIVELOG_WS_URL=ws://localhost:4504/ws

# Channels listed in the sub-sidebar, and the one selected on first load.
VITE_LIVELOG_CHANNELS=default
VITE_LIVELOG_DEFAULT_CHANNEL=default
