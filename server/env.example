# Copy to .env and fill in real values — `node --env-file=.env server.js` (Node
# 20.6+), or set them in the shell / with `fly secrets set`. Every variable is
# optional; the defaults are the ones shown.

PORT=8787
HOST=0.0.0.0

# Tokens: either inline JSON, or a path to a JSON file shaped like
# tokens.example.json. Only one is needed; the file wins if both are set.
LIVELOG_TOKENS_FILE=./tokens.json
# LIVELOG_TOKENS={"tokens":[{"token":"tk_live_...","label":"default","channels":["default"]}]}

# Browser origins allowed to POST logs. "*" is fine because every write still
# needs a valid token; list real origins to be stricter.
LIVELOG_ALLOWED_ORIGINS=*

# Paths (change only if you proxy them differently).
LIVELOG_LOG_PATH=/api/log
LIVELOG_WS_PATH=/ws

# Memory + replay.
LIVELOG_MAX_LOGS=5000
LIVELOG_REPLAY=200
LIVELOG_MAX_CHANNELS=200
LIVELOG_MAX_SUBSCRIBERS=100

# Payload size caps, in bytes.
LIVELOG_MAX_MESSAGE_BYTES=10240
LIVELOG_MAX_DATA_BYTES=51200
LIVELOG_MAX_SOURCE_CHARS=64

# Writes per token+channel (sustained / max burst).
LIVELOG_RATE_PER_SEC=20
LIVELOG_RATE_BURST=100

# Failed-auth attempts per IP.
LIVELOG_AUTH_PER_SEC=2
LIVELOG_AUTH_BURST=20

# Viewer socket caps.
LIVELOG_MAX_CONNECTIONS=500
LIVELOG_MAX_CONNECTIONS_PER_IP=20

# Set to 0 only when the process is exposed with no proxy in front, since
# x-forwarded-for is otherwise trivially spoofable.
LIVELOG_TRUST_PROXY=1
